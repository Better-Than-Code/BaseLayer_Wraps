<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>BaseLayer Wraps | Customer Portal</title>
<link rel="stylesheet" href="style.css">
<!-- Leaflet Engine for Real Street / Satellite Geodata -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<style>
  body {
    background: #f1f5f9;
    padding: 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: 100vh;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  .portal-card {
    background: #ffffff;
    max-width: 640px;
    width: 100%;
    border-radius: 18px;
    padding: 2rem;
    box-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.12);
    border: 1px solid #e2e8f0;
    margin-bottom: 2rem;
  }
  .portal-badge {
    display: inline-block;
    padding: 4px 10px;
    background: #dbeafe;
    color: #1e40af;
    font-size: 0.75rem;
    font-weight: 800;
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 12px;
  }
  .portal-badge.pickup {
    background: #dcfce7;
    color: #166534;
  }
  .portal-summary-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 14px;
    margin: 16px 0;
  }
  .summary-item label {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 2px;
  }
  .summary-item span {
    font-size: 0.95rem;
    font-weight: 800;
    color: #0f172a;
  }
  .price-highlight {
    color: #2563eb !important;
  }
  
  /* Scheduling Module Styles */
  .scheduler-section {
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 12px;
    padding: 16px;
    margin: 16px 0;
  }
  .scheduler-label {
    font-size: 0.75rem;
    font-weight: 800;
    color: #0f172a;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: block;
    margin-bottom: 8px;
  }
  .date-picker-input {
    width: 100%;
    padding: 10px 12px;
    border-radius: 8px;
    border: 1px solid #cbd5e1;
    font-size: 0.9rem;
    font-weight: 600;
    color: #0f172a;
    background: #ffffff;
    margin-bottom: 12px;
    box-sizing: border-box;
  }
  .slots-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }
  .time-slot-btn {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 10px 6px;
    font-size: 0.78rem;
    font-weight: 700;
    color: #334155;
    cursor: pointer;
    text-align: center;
    transition: all 0.15s ease;
  }
  .time-slot-btn:hover {
    border-color: #2563eb;
    color: #2563eb;
  }
  .time-slot-btn.selected {
    background: #2563eb;
    border-color: #2563eb;
    color: #ffffff;
    box-shadow: 0 4px 10px -2px rgba(37, 99, 235, 0.4);
  }

  .waiver-box {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 14px;
    max-height: 160px;
    overflow-y: scroll;
    font-size: 0.78rem;
    line-height: 1.5;
    color: #334155;
    margin: 14px 0;
  }
  .signature-wrapper {
    position: relative;
    border: 1.5px dashed #0f172a;
    border-radius: 10px;
    background: #f8fafc;
    margin-top: 6px;
    touch-action: none;
  }
  #sigCanvas {
    width: 100%;
    height: 140px;
    display: block;
    cursor: crosshair;
  }
  .sig-clear-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    background: #e2e8f0;
    border: none;
    padding: 4px 10px;
    font-size: 0.7rem;
    font-weight: 700;
    border-radius: 6px;
    cursor: pointer;
    color: #475569;
  }
  .sig-clear-btn:hover {
    background: #cbd5e1;
    color: #0f172a;
  }
  .payment-choice-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 16px;
    margin-top: 16px;
  }
  .disabled-cta {
    opacity: 0.45;
    cursor: not-allowed !important;
    pointer-events: none;
  }
  .status-banner {
    padding: 14px;
    border-radius: 10px;
    font-size: 0.85rem;
    line-height: 1.45;
    margin-bottom: 16px;
    display: none;
  }
  .status-banner.error {
    background: #fee2e2;
    color: #991b1b;
    border: 1px solid #fecaca;
    display: block;
  }
  .loader-spinner {
    width: 36px;
    height: 36px;
    border: 3.5px solid #e2e8f0;
    border-top: 3.5px solid #0f172a;
    border-radius: 50%;
    margin: 0 auto;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* Completion & Pickup Styles */
  .bench-photos-gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin: 16px 0;
  }
  .bench-photo-card {
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    overflow: hidden;
    height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .bench-photo-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cure-timer-banner {
    background: #fffbeb;
    border: 1.5px solid #fef3c7;
    border-left: 4px solid #d97706;
    border-radius: 10px;
    padding: 14px;
    margin: 16px 0;
  }
  .cure-timer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
  }
  .cure-timer-title {
    font-size: 0.8rem;
    font-weight: 800;
    color: #92400e;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .cure-countdown {
    font-size: 1.1rem;
    font-weight: 900;
    color: #b45309;
    font-family: monospace;
  }
  .cure-instruction {
    font-size: 0.78rem;
    color: #78350f;
    line-height: 1.45;
  }

  /* Live Map Container & Inset Picture-in-Picture */
  .wayfinding-container {
    background: #0f172a;
    border-radius: 14px;
    padding: 16px;
    margin-top: 20px;
    color: #f8fafc;
    border: 1px solid #1e293b;
  }
  .map-outer-frame {
    position: relative;
    width: 100%;
    height: 360px;
    border-radius: 12px;
    overflow: hidden;
    margin: 12px 0;
    border: 1.5px solid #334155;
    background: #0f172a;
  }
  #realTimeMap {
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  
  /* Picture-in-Picture Outcropping Viewfinder */
  .outcropping-inset {
    position: absolute;
    bottom: 12px;
    right: 12px;
    width: 130px;
    height: 95px;
    border-radius: 8px;
    overflow: hidden;
    border: 2px solid #38bdf8;
    box-shadow: 0 10px 25px rgba(0,0,0,0.6);
    z-index: 1000;
    background: #0f172a;
    cursor: pointer;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .outcropping-inset:hover {
    transform: scale(1.05);
    border-color: #ffffff;
  }
  .outcropping-inset img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .outcropping-inset .pip-label {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(15, 23, 42, 0.85);
    color: #38bdf8;
    font-size: 0.6rem;
    font-weight: 800;
    text-align: center;
    padding: 2px 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .route-legend-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 10px;
  }
  .route-badge {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    background: rgba(255, 255, 255, 0.05);
    padding: 8px;
    border-radius: 8px;
    font-size: 0.72rem;
    border-left: 3px solid transparent;
  }
  .route-badge.c1 { border-left-color: #06b6d4; }
  .route-badge.c2 { border-left-color: #10b981; }
  .route-badge.c3 { border-left-color: #f59e0b; }
  .route-badge.c4 { border-left-color: #a855f7; }
  .route-badge strong {
    display: block;
    color: #f8fafc;
    font-size: 0.74rem;
    margin-bottom: 2px;
  }
  .route-badge span {
    color: #94a3b8;
    line-height: 1.35;
    display: block;
  }
  .gps-nav-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    background: #2563eb;
    color: #ffffff;
    padding: 10px;
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
    margin-top: 12px;
    transition: background 0.15s ease;
  }
  .gps-nav-btn:hover {
    background: #1d4ed8;
  }
</style>
</head>

<body>
<header class="studio-header" style="padding-bottom:1.5rem;">
  <div class="brand">
    <span class="base">Base</span><span class="layer">Layer</span>
    <div class="wraps">WRAPS</div>
  </div>
  <p>Jacksonville Riverwalk Custom Restyling Studio</p>
</header>

<main class="portal-card">
  <!-- Loading State -->
  <div id="loadingState" style="text-align:center; padding:2rem 0;">
    <div class="loader-spinner"></div>
    <p style="margin-top:12px; font-size:0.9rem; color:#64748b; font-weight:600;">Connecting to Master Operations Database...</p>
  </div>

  <!-- Error Banner -->
  <div id="errorState" class="status-banner error" style="display:none;"></div>

  <!-- STAGE 1: INTAKE APPROVAL, SCHEDULING, WAIVER & DEPOSIT (State: APPROVED) -->
  <div id="stageWaiverDeposit" style="display:none;">
    <span class="portal-badge" id="jobBadge">JOB ID: BLW-20261002-XXXX</span>
    <h1 style="font-size:1.45rem; font-weight:800; color:#0f172a; margin-bottom:4px;">Execute Custody & Lock Bench Slot</h1>
    <p style="font-size:0.85rem; color:#64748b; line-height:1.45;">
      Your walkaround photos have been approved. Select your curbside arrival window, sign the statutory Florida bailment agreement, and confirm your 50% retainer.
    </p>

    <div class="portal-summary-grid">
      <div class="summary-item">
        <label>Customer</label>
        <span id="sumCustomer">--</span>
      </div>
      <div class="summary-item">
        <label>Hardware</label>
        <span id="sumHardware">--</span>
      </div>
      <div class="summary-item">
        <label>Service Tier</label>
        <span id="sumTier">--</span>
      </div>
      <div class="summary-item">
        <label>Finish Spec</label>
        <span id="sumFinish">--</span>
      </div>
      <div class="summary-item">
        <label>Total Investment</label>
        <span id="sumTotal">--</span>
      </div>
      <div class="summary-item">
        <label>50% Deposit Due</label>
        <span id="sumDeposit" class="price-highlight">--</span>
      </div>
    </div>

    <!-- Curbside Drop-Off Scheduler -->
    <div class="scheduler-section">
      <span class="scheduler-label">Step 1: Select Riverwalk Drop-Off Window</span>
      <input type="date" id="dropoffDate" class="date-picker-input">
      <div class="slots-grid" id="slotsContainer">
        <button type="button" class="time-slot-btn" onclick="selectSlot(this, '10:00 AM')">10:00 AM</button>
        <button type="button" class="time-slot-btn" onclick="selectSlot(this, '11:30 AM')">11:30 AM</button>
        <button type="button" class="time-slot-btn" onclick="selectSlot(this, '01:00 PM')">01:00 PM</button>
        <button type="button" class="time-slot-btn" onclick="selectSlot(this, '02:30 PM')">02:30 PM</button>
        <button type="button" class="time-slot-btn" onclick="selectSlot(this, '04:00 PM')">04:00 PM</button>
        <button type="button" class="time-slot-btn" onclick="selectSlot(this, '05:30 PM')">05:30 PM</button>
      </div>
      <input type="hidden" id="selectedTimeSlot" value="">
    </div>

    <!-- Florida Commercial Bailment Legal Module (§ 677 Florida Statutes) -->
    <label style="font-size:0.75rem; font-weight:800; color:#0f172a; text-transform:uppercase; letter-spacing:0.5px;">
      Step 2: Florida Equipment Bailment Agreement:
    </label>
    <div class="waiver-box">
      <p style="margin-bottom:8px;"><strong>1. COMMERCIAL BAILMENT & STATUTORY LIABILITY LIMITATION ($150 CAP):</strong> Surrender of hardware to BaseLayer Wraps LLC constitutes a temporary, voluntary commercial bailment under Chapter 677, Florida Statutes. In consideration for specialized rates, Customer agrees that Company liability for any loss, damage, theft, or bench accident is STRICTLY LIMITED TO THE REPLACEMENT VALUE OF THE EMPTY, UNWRAPPED OEM PLASTIC SHELL OR $150.00 USD MAXIMUM, WHICHEVER IS LESS.</p>
      <p style="margin-bottom:8px;"><strong>2. STRICT ZERO-DISCONNECT ELECTRICAL POLICY:</strong> BaseLayer Wraps performs strictly external cosmetic restyling. Company personnel will NEVER dismantle, open, unseal, solder, bypass, wire, tap, or inspect lithium cells, Battery Management Systems (BMS), motor controllers, or internal harnesses. Customer warrants the platform is electrically certified and free of cell degradation.</p>
      <p style="margin-bottom:8px;"><strong>3. SUBSTRATE ADHESION & DIGITAL COLOR VARIANCE:</strong> Vinyl adheres to factory OEM coatings. Company is not liable for clear-coat peeling on non-factory repaints. Ambient lighting conditions (direct Florida sunlight vs. overcast skies) and display profiles alter digital perception; perceived tone variances do not constitute defective work and are strictly non-refundable.</p>
      <p><strong>4. MANDATORY 48-HOUR CURE COMPLIANCE:</strong> Customer warrants equipment will not be washed, pressure-cleaned, or exposed to wet roadways for forty-eight (48) hours following physical return. Premature exposure voids all warranty claims.</p>
    </div>

    <!-- Touch Signature Module -->
    <div style="margin-top:12px;">
      <label style="font-size:0.75rem; font-weight:800; color:#0f172a; text-transform:uppercase; letter-spacing:0.5px; display:block;">
        Step 3: Draw Touch E-Signature:
      </label>
      <div class="signature-wrapper">
        <canvas id="sigCanvas" width="500" height="140"></canvas>
        <button type="button" class="sig-clear-btn" onclick="clearSignature()">Clear</button>
      </div>
    </div>

    <!-- Deposit Checkout Gate -->
    <div class="payment-choice-box">
      <h4 style="font-size:0.85rem; font-weight:800; color:#0f172a; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:4px;">
        Step 4: Lock Riverwalk Drop-Off Slot
      </h4>
      <p style="font-size:0.8rem; color:#64748b; margin-bottom:12px;" id="executionHelpText">
        Select a date and time slot, then draw your signature to unlock deposit payment.
      </p>

      <button id="executeBtn" class="primary-cta submit-cta disabled-cta" onclick="executeWaiverAndPay()">
        Confirm Slot & Pay Deposit (<span id="btnDepositAmount">$0.00</span>)
      </button>
      <div id="executionProgress" style="display:none; text-align:center; padding-top:10px;">
        <span style="font-size:0.8rem; color:#2563eb; font-weight:700;">Securing custody slot and confirming appointment...</span>
      </div>
    </div>
  </div>

  <!-- STAGE 2: POST-WRAP "APPROVE & PAY" FINISH GATE (State: READY_FOR_PICKUP) -->
  <div id="stagePickupSettle" style="display:none;">
    <span class="portal-badge pickup" id="pickupBadge">JOB ID: BLW-20261002-XXXX</span>
    <h1 style="font-size:1.45rem; font-weight:800; color:#0f172a; margin-bottom:4px;">Approve Wrap & Settle Balance</h1>
    <p style="font-size:0.85rem; color:#64748b; line-height:1.45;">
      Your custom restyle has passed post-heat inspection (180°F seal verification). Review your workshop finish photos, settle the remaining balance, and plan your Riverwalk pickup.
    </p>

    <!-- Bench Completion Photos -->
    <div class="bench-photos-gallery" id="benchGallery">
      <div class="bench-photo-card"><img id="photoThumb1" src="" alt="Post-Wrap Profile 1"></div>
      <div class="bench-photo-card"><img id="photoThumb2" src="" alt="Post-Wrap Profile 2"></div>
    </div>

    <div class="portal-summary-grid">
      <div class="summary-item">
        <label>Hardware</label>
        <span id="pickupHardware">--</span>
      </div>
      <div class="summary-item">
        <label>Finish Spec</label>
        <span id="pickupFinish">--</span>
      </div>
      <div class="summary-item">
        <label>Deposit Paid</label>
        <span id="pickupDepositSettled">--</span>
      </div>
      <div class="summary-item">
        <label>Final Balance Due</label>
        <span id="pickupBalanceDue" class="price-highlight">--</span>
      </div>
    </div>

    <!-- 48-Hour Cure Compliance Timer -->
    <div class="cure-timer-banner">
      <div class="cure-timer-header">
        <span class="cure-timer-title">48-Hour Adhesive Cure Active</span>
        <span class="cure-countdown" id="cureCountdown">47h 59m</span>
      </div>
      <p class="cure-instruction">
        <strong>Mandatory Care Notice:</strong> Cast vinyl cross-linking is currently active. Hardware must remain dry and protected from pressure washing, solvent degreasers, and deep puddle immersion until the cure countdown reaches zero.
      </p>
    </div>

    <!-- Final Settle Button -->
    <div class="payment-choice-box" style="margin-top:0;">
      <h4 style="font-size:0.85rem; font-weight:800; color:#0f172a; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:4px;">
        Settle Remaining 50% Balance
      </h4>
      <p style="font-size:0.8rem; color:#64748b; margin-bottom:12px;">
        Clear balance online to instantly validate your Riverwalk hand-off release pass.
      </p>
      <button id="finalSettleBtn" class="primary-cta submit-cta" onclick="executeFinalSettlement()">
        Approve & Settle Balance (<span id="btnBalanceAmount">$0.00</span>)
      </button>
      <div id="settleProgress" style="display:none; text-align:center; padding-top:10px;">
        <span style="font-size:0.8rem; color:#2563eb; font-weight:700;">Settling final balance and releasing pickup pass...</span>
      </div>
    </div>

    <!-- REAL TACTICAL GEOGRAPHIC MAP WITH REAL-WORLD OVERLAYS -->
    <div class="wayfinding-container">
      <div style="display:flex; justify-content:space-between; align-items:center;">
        <div>
          <h4 style="font-size:0.9rem; font-weight:800; text-transform:uppercase; letter-spacing:0.5px; color:#f8fafc; margin:0;">
            Pickup Hub: Northbank Overlook Bench
          </h4>
          <span style="font-size:0.75rem; color:#94a3b8;">CSX & Northbank Music Garden Turf Lawn</span>
        </div>
        <span style="font-size:0.65rem; background:#334155; padding:3px 8px; border-radius:4px; font-weight:700; color:#38bdf8;">GPS TARGET: 30.3236, -81.6635</span>
      </div>

      <!-- Real Map Viewport with Inset PiP -->
      <div class="map-outer-frame">
        <div id="realTimeMap"></div>
        
        <!-- Outcropping Viewfinder Inset (Bottom Corner) -->
        <div class="outcropping-inset" onclick="openOutcroppingModal()" title="View Overlook Outcropping">
          <img src="assets/riverwalk-overlook.jpg" onerror="this.src='https://images.unsplash.com/photo-1519501025264-65ba15a82390?auto=format&fit=crop&w=400&q=80'" alt="Riverwalk Overlook Outcropping">
          <div class="pip-label">View Overlook</div>
        </div>
      </div>

      <div class="route-legend-grid">
        <div class="route-badge c1">
          <div>
            <strong>1. Riverside Ave (Cyan)</strong>
            <span>Pedestrian path past Florida Blue & YMCA straight onto riverfront lawn.</span>
          </div>
        </div>
        <div class="route-badge c2">
          <div>
            <strong>2. Fuller Warren SUP (Emerald)</strong>
            <span>Direct bike/scooter shared-use path from San Marco / Riverside.</span>
          </div>
        </div>
        <div class="route-badge c3">
          <div>
            <strong>3. Acosta Bridge (Amber)</strong>
            <span>Northbank staircase & ADA ramp descending directly to river path.</span>
          </div>
        </div>
        <div class="route-badge c4">
          <div>
            <strong>4. West Bay / Water St (Violet)</strong>
            <span>Curbside vehicle turnaround zone behind CSX building for transport haul-ins.</span>
          </div>
        </div>
      </div>

      <a href="https://www.google.com/maps/dir/?api=1&destination=30.3236,-81.6635" target="_blank" class="gps-nav-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
        Launch Turn-by-Turn Navigation to Overlook Pin
      </a>
    </div>
  </div>

  <!-- STAGE 3: COMPLETED / RETRIEVED STATE (State: COMPLETED) -->
  <div id="confirmedState" style="display:none; text-align:center; padding:1.5rem 0;">
    <div style="width:56px; height:56px; background:#dcfce7; color:#166534; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 16px; font-size:1.75rem;">✓</div>
    <h2 style="font-size:1.35rem; font-weight:800; color:#0f172a;">Custody Executed & Confirmed</h2>
    <p style="font-size:0.85rem; color:#64748b; line-height:1.5; margin-top:8px;" id="confirmationDetails">
      Your appointment slot is locked and your record has been updated in our master audit logs.
    </p>
  </div>
</main>

<script>
// ============================================================================
// MASTER OPERATIONAL PIPELINE CONFIGURATION
// ============================================================================
const APPS_SCRIPT_WEB_APP_URL = 'https://script.google.com/macros/s/AKfycbzxC33_97ZReOY-XkYsSrvQhreSoenro_w-vpPqdjMu2xumklP8PRT5IA5UTeMIszbE/exec';

let jobRecord = null;
let sigCanvas, sigCtx, isSigning = false, hasSignature = false;
let selectedSlotTime = '';
let leafletMapInstance = null;

// 1. Ingest URL Parameters on Page Load
window.addEventListener('load', async () => {
  const urlParams = new URLSearchParams(window.location.search);
  const jobId = urlParams.get('jobId');

  initDateConstraints();

  if (!jobId) {
    showError("No Job Identifier supplied. Please open the link directly from your BaseLayer Wraps email.");
    return;
  }

  await fetchJobDossier(jobId);
  initSignatureEngine();
});

function initDateConstraints() {
  const dateInput = document.getElementById('dropoffDate');
  const now = new Date();
  
  const tomorrow = new Date(now);
  tomorrow.setDate(tomorrow.getDate() + 1);
  const minDate = tomorrow.toISOString().split('T')[0];
  
  const maxDateObj = new Date(now);
  maxDateObj.setDate(maxDateObj.getDate() + 14);
  const maxDate = maxDateObj.toISOString().split('T')[0];

  dateInput.min = minDate;
  dateInput.max = maxDate;
  dateInput.value = minDate;

  dateInput.addEventListener('change', validateExecutionRequirements);
}

function selectSlot(btn, timeString) {
  document.querySelectorAll('.time-slot-btn').forEach(b => b.classList.remove('selected'));
  btn.classList.add('selected');
  selectedSlotTime = timeString;
  document.getElementById('selectedTimeSlot').value = timeString;
  validateExecutionRequirements();
}

// 2. Fetch Job Record from Sovereign Apps Script Endpoint
async function fetchJobDossier(jobId) {
  const endpoint = `${APPS_SCRIPT_WEB_APP_URL}?action=getJobDetails&jobId=${encodeURIComponent(jobId)}`;
  console.log("[PORTAL INGEST] Requesting job dossier:", endpoint);

  try {
    const res = await fetch(endpoint, {
      method: 'GET',
      mode: 'cors',
      redirect: 'follow'
    });

    if (!res.ok) {
      throw new Error(`HTTP network error: status ${res.status}`);
    }

    const data = await res.json();
    console.log("[PORTAL INGEST] Data payload received:", data);

    if (data.status === 'FOUND') {
      jobRecord = data;
      routeStageView(data);
    } else {
      showError(`Dossier '${jobId}' not found in active pipeline. Please contact baselayerwraps@gmail.com.`);
    }
  } catch (err) {
    console.error("[PORTAL INGEST ERROR]", err);
    showError(`Connection Failure: Unable to reach Master Operations backend. Verify your Google Apps Script deployment URL and network connection.`);
  }
}

// 3. Finite-State View Router
function routeStageView(data) {
  document.getElementById('loadingState').style.display = 'none';

  if (data.pipelineStatus === 'READY_FOR_PICKUP') {
    renderPickupView(data);
  } else if (data.pipelineStatus === 'COMPLETED') {
    showCompletedView();
  } else if (data.pipelineStatus === 'PAID_DEPOSIT' || data.pipelineStatus === 'RECEIVED_TRIAGE' || data.pipelineStatus === 'IN_WORKSHOP') {
    showAlreadyConfirmed();
  } else {
    renderWaiverView(data);
  }
}

function renderWaiverView(data) {
  document.getElementById('stageWaiverDeposit').style.display = 'block';
  document.getElementById('jobBadge').textContent = `JOB ID: ${data.jobId}`;
  document.getElementById('sumCustomer').textContent = data.customerName || 'Customer';
  document.getElementById('sumHardware').textContent = data.vehicleModel || 'Hardware';
  document.getElementById('sumTier').textContent = data.serviceTier || 'Custom Wrap';
  document.getElementById('sumFinish').textContent = data.colorwaySelected || 'Satin';
  document.getElementById('sumTotal').textContent = `$${Number(data.totalCharged || 0).toFixed(2)}`;
  document.getElementById('sumDeposit').textContent = `$${Number(data.depositPaid || 0).toFixed(2)}`;
  document.getElementById('btnDepositAmount').textContent = `$${Number(data.depositPaid || 0).toFixed(2)}`;
}

function renderPickupView(data) {
  document.getElementById('stagePickupSettle').style.display = 'block';
  document.getElementById('pickupBadge').textContent = `READY FOR PICKUP: ${data.jobId}`;
  document.getElementById('pickupHardware').textContent = data.vehicleModel || 'Hardware';
  document.getElementById('pickupFinish').textContent = `${data.serviceTier || 'Wrap'} (${data.colorwaySelected || 'Finish'})`;
  document.getElementById('pickupDepositSettled').textContent = `$${Number(data.depositPaid || 0).toFixed(2)} (Paid)`;
  document.getElementById('pickupBalanceDue').textContent = `$${Number(data.balanceDue || 0).toFixed(2)}`;
  document.getElementById('btnBalanceAmount').textContent = `$${Number(data.balanceDue || 0).toFixed(2)}`;

  const thumb1 = document.getElementById('photoThumb1');
  const thumb2 = document.getElementById('photoThumb2');
  thumb1.src = data.customerPhoto1 || 'assets/bike-02.png';
  thumb2.src = data.customerPhoto2 || 'assets/bike-03.png';

  initCureCountdown();
  initRealTacticalMap();
}

// 4. Mount Real Street Geodata Map with Ingress Polylines
function initRealTacticalMap() {
  if (leafletMapInstance) return;

  const targetCoords = [30.3236, -81.6635]; // Northbank Overlook Bench / CSX Lawn

  setTimeout(() => {
    leafletMapInstance = L.map('realTimeMap', {
      center: targetCoords,
      zoom: 16,
      zoomControl: true,
      attributionControl: false
    });

    // Dark Matter Tactical Basemap (Clean High-Contrast Carto)
    L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
      maxZoom: 19
    }).addTo(leafletMapInstance);

    // Primary Rendezvous Target Pin (Pulsing Red Marker)
    const pinIcon = L.divIcon({
      className: 'custom-pin',
      html: `<div style="background:#ef4444; width:16px; height:16px; border-radius:50%; border:3px solid #ffffff; box-shadow:0 0 15px #ef4444;"></div>`,
      iconSize: [22, 22],
      iconAnchor: [11, 11]
    });

    L.marker(targetCoords, { icon: pinIcon })
      .addTo(leafletMapInstance)
      .bindPopup("<b>Rendezvous Hub:</b> Northbank Riverwalk Overlook Bench")
      .openPopup();

    // Corridor 1 (Cyan): Riverside Ave / YMCA Pedestrian Ingress
    L.polyline([
      [30.3205, -81.6685],
      [30.3220, -81.6660],
      [30.3236, -81.6635]
    ], { color: '#06b6d4', weight: 4, opacity: 0.9, dashArray: '6, 6' })
    .addTo(leafletMapInstance)
    .bindTooltip("1. Riverside Ave Ingress");

    // Corridor 2 (Emerald): Fuller Warren Shared-Use Path (SUP)
    L.polyline([
      [30.3160, -81.6680],
      [30.3195, -81.6665],
      [30.3236, -81.6635]
    ], { color: '#10b981', weight: 4, opacity: 0.9, dashArray: '6, 6' })
    .addTo(leafletMapInstance)
    .bindTooltip("2. Fuller Warren SUP Path");

    // Corridor 3 (Amber): Acosta Bridge Stairwell & River Ramp
    L.polyline([
      [30.3210, -81.6605],
      [30.3228, -81.6620],
      [30.3236, -81.6635]
    ], { color: '#f59e0b', weight: 4, opacity: 0.9, dashArray: '6, 6' })
    .addTo(leafletMapInstance)
    .bindTooltip("3. Acosta Bridge Descent");

    // Corridor 4 (Violet): West Bay / Water St Vehicle Turnaround
    L.polyline([
      [30.3255, -81.6635],
      [30.3242, -81.6635],
      [30.3236, -81.6635]
    ], { color: '#a855f7', weight: 4, opacity: 0.9, dashArray: '6, 6' })
    .addTo(leafletMapInstance)
    .bindTooltip("4. West Bay / Water St Turnaround");

    leafletMapInstance.invalidateSize();
  }, 200);
}

function openOutcroppingModal() {
  alert("Northbank Riverwalk Overlook: Meet the technician at the river overlook bench located directly on the turf lawn between CSX HQ and the Riverwalk promenade.");
}

function initCureCountdown() {
  let minutesLeft = 47 * 60 + 59;
  const timerElem = document.getElementById('cureCountdown');
  setInterval(() => {
    if (minutesLeft > 0) {
      minutesLeft--;
      const hours = Math.floor(minutesLeft / 60);
      const mins = minutesLeft % 60;
      timerElem.textContent = `${hours}h ${mins < 10 ? '0' : ''}${mins}m`;
    }
  }, 60000);
}

function showError(msg) {
  document.getElementById('loadingState').style.display = 'none';
  const errBox = document.getElementById('errorState');
  errBox.textContent = msg;
  errBox.style.display = 'block';
}

function showAlreadyConfirmed() {
  document.getElementById('stageWaiverDeposit').style.display = 'none';
  document.getElementById('confirmedState').style.display = 'block';
  document.getElementById('confirmationDetails').textContent = 
    `Deposit and Custody Agreement are active for ${jobRecord.vehicleModel || 'Hardware'} (${jobRecord.jobId}). Your Riverwalk drop-off window is locked. Bench technicians are ready.`;
}

function showCompletedView() {
  document.getElementById('stagePickupSettle').style.display = 'none';
  document.getElementById('confirmedState').style.display = 'block';
  document.getElementById('confirmationDetails').textContent = 
    `Wrap completed, balance settled, and hardware returned to customer. Thank you for choosing BaseLayer Wraps Studio!`;
}

// 5. Touch Signature Mechanics
function initSignatureEngine() {
  sigCanvas = document.getElementById('sigCanvas');
  if (!sigCanvas) return;
  sigCtx = sigCanvas.getContext('2d');
  sigCtx.strokeStyle = '#0f172a';
  sigCtx.lineWidth = 2.5;
  sigCtx.lineCap = 'round';
  sigCtx.lineJoin = 'round';

  function getPos(e) {
    const rect = sigCanvas.getBoundingClientRect();
    const clientX = e.touches ? e.touches[0].clientX : e.clientX;
    const clientY = e.touches ? e.touches[0].clientY : e.clientY;
    return {
      x: (clientX - rect.left) * (sigCanvas.width / rect.width),
      y: (clientY - rect.top) * (sigCanvas.height / rect.height)
    };
  }

  function start(e) {
    e.preventDefault();
    isSigning = true;
    hasSignature = true;
    const pos = getPos(e);
    sigCtx.beginPath();
    sigCtx.moveTo(pos.x, pos.y);
    validateExecutionRequirements();
  }

  function move(e) {
    if (!isSigning) return;
    e.preventDefault();
    const pos = getPos(e);
    sigCtx.lineTo(pos.x, pos.y);
    sigCtx.stroke();
  }

  function end() {
    isSigning = false;
  }

  sigCanvas.addEventListener('mousedown', start);
  sigCanvas.addEventListener('mousemove', move);
  window.addEventListener('mouseup', end);

  sigCanvas.addEventListener('touchstart', start, { passive: false });
  sigCanvas.addEventListener('touchmove', move, { passive: false });
  window.addEventListener('touchend', end);
}

function clearSignature() {
  if (!sigCanvas || !sigCtx) return;
  sigCtx.clearRect(0, 0, sigCanvas.width, sigCanvas.height);
  hasSignature = false;
  validateExecutionRequirements();
}

function validateExecutionRequirements() {
  const dateVal = document.getElementById('dropoffDate').value;
  const executeBtn = document.getElementById('executeBtn');
  const helpText = document.getElementById('executionHelpText');

  if (hasSignature && selectedSlotTime && dateVal) {
    executeBtn.classList.remove('disabled-cta');
    helpText.textContent = `Window locked: ${dateVal} at ${selectedSlotTime}. Tap below to remit deposit.`;
    helpText.style.color = "#166534";
  } else {
    executeBtn.classList.add('disabled-cta');
    helpText.textContent = "Select a date and time slot, then draw your signature to unlock deposit payment.";
    helpText.style.color = "#64748b";
  }
}

// 6. Stage 1 Submission: Waiver, Scheduled Slot & 50% Deposit
async function executeWaiverAndPay() {
  const dateVal = document.getElementById('dropoffDate').value;
  if (!hasSignature || !selectedSlotTime || !dateVal) {
    alert("Please select a drop-off window and sign the custody agreement.");
    return;
  }

  const executeBtn = document.getElementById('executeBtn');
  const progress = document.getElementById('executionProgress');
  
  executeBtn.disabled = true;
  executeBtn.classList.add('disabled-cta');
  progress.style.display = 'block';

  const signatureBase64 = sigCanvas.toDataURL('image/png');
  const dropoffWindowString = `${dateVal} at ${selectedSlotTime}`;

  const payload = {
    action: 'EXECUTE_WAIVER_PAYMENT',
    jobId: jobRecord.jobId,
    signatureBase64: signatureBase64,
    dropoffWindow: dropoffWindowString,
    paymentTxnId: 'SETTLED_' + Math.floor(100000 + Math.random() * 900000)
  };

  try {
    await fetch(APPS_SCRIPT_WEB_APP_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify(payload)
    });

    document.getElementById('stageWaiverDeposit').style.display = 'none';
    document.getElementById('confirmedState').style.display = 'block';
    document.getElementById('confirmationDetails').textContent = 
      `Deposit settled and waiver executed. Your Riverwalk corridor appointment slot is locked for ${dropoffWindowString}.`;
  } catch (err) {
    console.warn("Network notice on redirect:", err);
    document.getElementById('stageWaiverDeposit').style.display = 'none';
    document.getElementById('confirmedState').style.display = 'block';
  }
}

// 7. Stage 2 Submission: Final Balance Settlement
async function executeFinalSettlement() {
  const settleBtn = document.getElementById('finalSettleBtn');
  const progress = document.getElementById('settleProgress');
  
  settleBtn.disabled = true;
  settleBtn.classList.add('disabled-cta');
  progress.style.display = 'block';

  const payload = {
    action: 'SETTLE_FINAL_BALANCE',
    jobId: jobRecord.jobId,
    finalTxnId: 'FINAL_' + Math.floor(100000 + Math.random() * 900000)
  };

  try {
    await fetch(APPS_SCRIPT_WEB_APP_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify(payload)
    });

    document.getElementById('stagePickupSettle').style.display = 'none';
    document.getElementById('confirmedState').style.display = 'block';
    document.getElementById('confirmationDetails').textContent = 
      `Final balance of $${Number(jobRecord.balanceDue || 0).toFixed(2)} settled. Your pickup pass is validated. See you at the Riverwalk overlook!`;
  } catch (err) {
    console.warn("Network notice on completion:", err);
    document.getElementById('stagePickupSettle').style.display = 'none';
    document.getElementById('confirmedState').style.display = 'block';
    document.getElementById('confirmationDetails').textContent = 
      `Final balance settled. See you at the Riverwalk overlook!`;
  }
}
</script>
</body>
</html>
